#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
restart=false
for arg in "$@"; do
    case "$arg" in
        -r|--restart) restart=true ;;
        *) echo "Usage: $0 [--restart]" >&2; exit 2 ;;
    esac
done
command -v kpackagetool6 >/dev/null || { echo 'kpackagetool6 is required.' >&2; exit 1; }
python3 tools/install-package.py
if "$restart"; then
    systemctl --user restart plasma-plasmashell.service
else
    echo 'Installed. Log out and back in to reload an existing instance without removing it.'
fi
